digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="1", fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.7];
"access_sessions" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>access_sessions</B></FONT></TD></TR><TR><TD PORT="token_hash" ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="token_hash_out">PK</TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="user_id_out">FK</TD></TR><TR><TD PORT="csrf_token" ALIGN="LEFT">csrf_token</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="csrf_token_out"></TD></TR><TR><TD PORT="expires_at" ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="expires_at_out"></TD></TR></TABLE>>];
"organizations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>organizations</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="name_out"></TD></TR><TR><TD PORT="kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="kind_out"></TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD PORT="active_out"></TD></TR><TR><TD PORT="supplied_goods" ALIGN="LEFT">supplied_goods</TD><TD ALIGN="LEFT">VARCHAR(1000)</TD><TD PORT="supplied_goods_out"></TD></TR></TABLE>>];
"partner_memberships" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>partner_memberships</B></FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="user_id_out">PK,FK</TD></TR><TR><TD PORT="organization_id" ALIGN="LEFT">organization_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="organization_id_out">PK,FK</TD></TR></TABLE>>];
"skus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>skus</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="name_out"></TD></TR><TR><TD PORT="base_unit" ALIGN="LEFT">base_unit</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="base_unit_out"></TD></TR><TR><TD PORT="owner_id" ALIGN="LEFT">owner_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="owner_id_out">FK</TD></TR></TABLE>>];
"storage_locations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>storage_locations</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="warehouse_id" ALIGN="LEFT">warehouse_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="warehouse_id_out">FK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out"></TD></TR><TR><TD PORT="rack_row" ALIGN="LEFT">rack_row</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="rack_row_out"></TD></TR><TR><TD PORT="rack_level" ALIGN="LEFT">rack_level</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="rack_level_out"></TD></TR><TR><TD PORT="rack_bay" ALIGN="LEFT">rack_bay</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="rack_bay_out"></TD></TR><TR><TD PORT="rack_depth" ALIGN="LEFT">rack_depth</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="rack_depth_out"></TD></TR></TABLE>>];
"supply_relationships" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>supply_relationships</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="supplier_id" ALIGN="LEFT">supplier_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="supplier_id_out">FK</TD></TR><TR><TD PORT="owner_id" ALIGN="LEFT">owner_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="owner_id_out">FK</TD></TR><TR><TD PORT="sku_id" ALIGN="LEFT">sku_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="sku_id_out">FK</TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="username" ALIGN="LEFT">username</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="username_out">UK</TD></TR><TR><TD PORT="password_hash" ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="password_hash_out"></TD></TR><TR><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="role_out"></TD></TR><TR><TD PORT="warehouse_scope" ALIGN="LEFT">warehouse_scope</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="warehouse_scope_out"></TD></TR><TR><TD PORT="active" ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD PORT="active_out"></TD></TR><TR><TD PORT="display_name" ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="display_name_out"></TD></TR><TR><TD PORT="deleted_at" ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="deleted_at_out"></TD></TR><TR><TD PORT="version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="version_out"></TD></TR></TABLE>>];
"warehouses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>warehouses</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="name_out">UK</TD></TR></TABLE>>];
"users":"id_out":e -> "access_sessions":"user_id":w [label="1 : 0..N"];
"organizations":"id_out":e -> "partner_memberships":"organization_id":w [label="1 : 0..N"];
"users":"id_out":e -> "partner_memberships":"user_id":w [label="1 : 0..N"];
"organizations":"id_out":e -> "skus":"owner_id":w [label="1 : 0..N"];
"warehouses":"id_out":e -> "storage_locations":"warehouse_id":w [label="1 : 0..N"];
"organizations":"id_out":e -> "supply_relationships":"owner_id":w [label="1 : 0..N"];
"skus":"id_out":e -> "supply_relationships":"sku_id":w [label="1 : 0..N"];
"organizations":"id_out":e -> "supply_relationships":"supplier_id":w [label="1 : 0..N"];
}
