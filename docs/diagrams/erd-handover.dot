digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="1", fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.7];
"handover_confirmations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>handover_confirmations</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="task_id_out">FK</TD></TR><TR><TD PORT="side" ALIGN="LEFT">side</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="side_out"></TD></TR><TR><TD PORT="version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="version_out"></TD></TR><TR><TD PORT="actor_id" ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="actor_id_out"></TD></TR><TR><TD PORT="at" ALIGN="LEFT">at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="at_out"></TD></TR></TABLE>>];
"handover_receipts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>handover_receipts</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="task_id_out">FK,UK</TD></TR><TR><TD PORT="number" ALIGN="LEFT">number</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="number_out">UK</TD></TR><TR><TD PORT="issued_at" ALIGN="LEFT">issued_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="issued_at_out"></TD></TR></TABLE>>];
"inventory_balances" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>inventory_balances</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR></TABLE>>];
"inventory_postings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>inventory_postings</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="reservation_id" ALIGN="LEFT">reservation_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="reservation_id_out">FK,UK</TD></TR><TR><TD PORT="balance_id" ALIGN="LEFT">balance_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="balance_id_out">FK</TD></TR><TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="task_id_out">FK</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quantity_out"></TD></TR><TR><TD PORT="kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="kind_out"></TD></TR><TR><TD PORT="at" ALIGN="LEFT">at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="at_out"></TD></TR></TABLE>>];
"package_scans" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>package_scans</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="task_id_out">FK</TD></TR><TR><TD PORT="package_id" ALIGN="LEFT">package_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="package_id_out">FK</TD></TR><TR><TD PORT="at" ALIGN="LEFT">at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="at_out"></TD></TR></TABLE>>];
"packages" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>packages</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR></TABLE>>];
"pickup_tasks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>pickup_tasks</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR><TR><TD PORT="warehouse_name" ALIGN="LEFT">warehouse_name</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="warehouse_name_out"></TD></TR><TR><TD PORT="shipper_id" ALIGN="LEFT">shipper_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="shipper_id_out"></TD></TR><TR><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="status_out"></TD></TR><TR><TD PORT="version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="version_out"></TD></TR><TR><TD PORT="shipper_accepted" ALIGN="LEFT">shipper_accepted</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD PORT="shipper_accepted_out"></TD></TR><TR><TD PORT="arrived_at_warehouse" ALIGN="LEFT">arrived_at_warehouse</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD PORT="arrived_at_warehouse_out"></TD></TR></TABLE>>];
"stock_reservations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>stock_reservations</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="task_id_out">FK</TD></TR><TR><TD PORT="balance_id" ALIGN="LEFT">balance_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="balance_id_out">FK</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quantity_out"></TD></TR><TR><TD PORT="state" ALIGN="LEFT">state</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="state_out"></TD></TR></TABLE>>];
"pickup_tasks":"id_out":e -> "handover_confirmations":"task_id":w [label="1 : 0..N"];
"pickup_tasks":"id_out":e -> "handover_receipts":"task_id":w [label="1 : 0..1"];
"inventory_balances":"id_out":e -> "inventory_postings":"balance_id":w [label="1 : 0..N"];
"stock_reservations":"id_out":e -> "inventory_postings":"reservation_id":w [label="1 : 0..1"];
"pickup_tasks":"id_out":e -> "inventory_postings":"task_id":w [label="1 : 0..N"];
"packages":"id_out":e -> "package_scans":"package_id":w [label="1 : 0..N"];
"pickup_tasks":"id_out":e -> "package_scans":"task_id":w [label="1 : 0..N"];
"inventory_balances":"id_out":e -> "stock_reservations":"balance_id":w [label="1 : 0..N"];
"pickup_tasks":"id_out":e -> "stock_reservations":"task_id":w [label="1 : 0..N"];
}
