digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="1", fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.7];
"balance_locations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>balance_locations</B></FONT></TD></TR><TR><TD PORT="balance_id" ALIGN="LEFT">balance_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="balance_id_out">PK,FK</TD></TR><TR><TD PORT="location_id" ALIGN="LEFT">location_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="location_id_out">FK</TD></TR></TABLE>>];
"inbound_lines" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>inbound_lines</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="request_id" ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="request_id_out">FK</TD></TR><TR><TD PORT="sku_id" ALIGN="LEFT">sku_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="sku_id_out">FK</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quantity_out"></TD></TR><TR><TD PORT="good" ALIGN="LEFT">good</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="good_out"></TD></TR><TR><TD PORT="quarantined" ALIGN="LEFT">quarantined</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quarantined_out"></TD></TR></TABLE>>];
"inbound_postings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>inbound_postings</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="line_id" ALIGN="LEFT">line_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="line_id_out">FK,UK</TD></TR><TR><TD PORT="balance_id" ALIGN="LEFT">balance_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="balance_id_out">FK</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quantity_out"></TD></TR><TR><TD PORT="quarantined" ALIGN="LEFT">quarantined</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quarantined_out"></TD></TR><TR><TD PORT="at" ALIGN="LEFT">at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="at_out"></TD></TR></TABLE>>];
"inbound_requests" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>inbound_requests</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR><TR><TD PORT="supplier_id" ALIGN="LEFT">supplier_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="supplier_id_out">FK</TD></TR><TR><TD PORT="owner_id" ALIGN="LEFT">owner_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="owner_id_out">FK</TD></TR><TR><TD PORT="warehouse_id" ALIGN="LEFT">warehouse_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="warehouse_id_out">FK</TD></TR><TR><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="status_out"></TD></TR><TR><TD PORT="version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="version_out"></TD></TR><TR><TD PORT="note" ALIGN="LEFT">note</TD><TD ALIGN="LEFT">TEXT</TD><TD PORT="note_out"></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="created_at_out"></TD></TR></TABLE>>];
"inventory_balances" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>inventory_balances</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="owner_id" ALIGN="LEFT">owner_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="owner_id_out">FK</TD></TR><TR><TD PORT="sku_code" ALIGN="LEFT">sku_code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="sku_code_out">FK</TD></TR><TR><TD PORT="warehouse_id" ALIGN="LEFT">warehouse_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="warehouse_id_out">FK</TD></TR><TR><TD PORT="on_hand" ALIGN="LEFT">on_hand</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="on_hand_out"></TD></TR><TR><TD PORT="reserved" ALIGN="LEFT">reserved</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="reserved_out"></TD></TR><TR><TD PORT="unavailable" ALIGN="LEFT">unavailable</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="unavailable_out"></TD></TR></TABLE>>];
"organizations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>organizations</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR></TABLE>>];
"skus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>skus</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR></TABLE>>];
"storage_locations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>storage_locations</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR></TABLE>>];
"warehouses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>warehouses</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="name_out">UK</TD></TR></TABLE>>];
"inventory_balances":"id_out":e -> "balance_locations":"balance_id":w [label="1 : 0..1"];
"storage_locations":"id_out":e -> "balance_locations":"location_id":w [label="1 : 0..N"];
"inbound_requests":"id_out":e -> "inbound_lines":"request_id":w [label="1 : 0..N"];
"skus":"id_out":e -> "inbound_lines":"sku_id":w [label="1 : 0..N"];
"inventory_balances":"id_out":e -> "inbound_postings":"balance_id":w [label="1 : 0..N"];
"inbound_lines":"id_out":e -> "inbound_postings":"line_id":w [label="1 : 0..1"];
"organizations":"id_out":e -> "inbound_requests":"owner_id":w [label="1 : 0..N"];
"organizations":"id_out":e -> "inbound_requests":"supplier_id":w [label="1 : 0..N"];
"warehouses":"id_out":e -> "inbound_requests":"warehouse_id":w [label="1 : 0..N"];
"organizations":"id_out":e -> "inventory_balances":"owner_id":w [label="1 : 0..N"];
"skus":"code_out":e -> "inventory_balances":"sku_code":w [label="1 : 0..N"];
"warehouses":"id_out":e -> "inventory_balances":"warehouse_id":w [label="1 : 0..N"];
}
