digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="1", fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.7];
"inventory_balances" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>inventory_balances</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR></TABLE>>];
"organizations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>organizations</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR></TABLE>>];
"outbound_allocations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>outbound_allocations</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="line_id" ALIGN="LEFT">line_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="line_id_out">FK</TD></TR><TR><TD PORT="balance_id" ALIGN="LEFT">balance_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="balance_id_out">FK</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quantity_out"></TD></TR><TR><TD PORT="state" ALIGN="LEFT">state</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="state_out"></TD></TR></TABLE>>];
"outbound_lines" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>outbound_lines</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="request_id" ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="request_id_out">FK</TD></TR><TR><TD PORT="sku_id" ALIGN="LEFT">sku_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="sku_id_out">FK</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quantity_out"></TD></TR></TABLE>>];
"outbound_requests" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>outbound_requests</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR><TR><TD PORT="owner_id" ALIGN="LEFT">owner_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="owner_id_out">FK</TD></TR><TR><TD PORT="warehouse_id" ALIGN="LEFT">warehouse_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="warehouse_id_out">FK</TD></TR><TR><TD PORT="shipper_mode" ALIGN="LEFT">shipper_mode</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="shipper_mode_out"></TD></TR><TR><TD PORT="shipper_id" ALIGN="LEFT">shipper_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="shipper_id_out"></TD></TR><TR><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="status_out"></TD></TR><TR><TD PORT="version" ALIGN="LEFT">version</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="version_out"></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="created_at_out"></TD></TR></TABLE>>];
"outbound_tasks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>outbound_tasks</B></FONT></TD></TR><TR><TD PORT="request_id" ALIGN="LEFT">request_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="request_id_out">PK,FK</TD></TR><TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="task_id_out">FK,UK</TD></TR></TABLE>>];
"package_items" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>package_items</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="package_id" ALIGN="LEFT">package_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="package_id_out">FK</TD></TR><TR><TD PORT="line_id" ALIGN="LEFT">line_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="line_id_out">FK</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quantity_out"></TD></TR></TABLE>>];
"packages" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>packages</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="task_id_out">FK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR></TABLE>>];
"pickup_tasks" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>pickup_tasks</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR></TABLE>>];
"skus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>skus</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="code_out">UK</TD></TR></TABLE>>];
"warehouses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#475569"><FONT COLOR="white"><B>warehouses</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="name_out">UK</TD></TR></TABLE>>];
"inventory_balances":"id_out":e -> "outbound_allocations":"balance_id":w [label="1 : 0..N"];
"outbound_lines":"id_out":e -> "outbound_allocations":"line_id":w [label="1 : 0..N"];
"outbound_requests":"id_out":e -> "outbound_lines":"request_id":w [label="1 : 0..N"];
"skus":"id_out":e -> "outbound_lines":"sku_id":w [label="1 : 0..N"];
"organizations":"id_out":e -> "outbound_requests":"owner_id":w [label="1 : 0..N"];
"warehouses":"id_out":e -> "outbound_requests":"warehouse_id":w [label="1 : 0..N"];
"outbound_requests":"id_out":e -> "outbound_tasks":"request_id":w [label="1 : 0..1"];
"pickup_tasks":"id_out":e -> "outbound_tasks":"task_id":w [label="1 : 0..1"];
"outbound_lines":"id_out":e -> "package_items":"line_id":w [label="1 : 0..N"];
"packages":"id_out":e -> "package_items":"package_id":w [label="1 : 0..N"];
"pickup_tasks":"id_out":e -> "packages":"task_id":w [label="1 : 0..N"];
}
