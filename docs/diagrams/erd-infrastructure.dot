digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="1", fontname="Arial"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#64748b", fontcolor="#334155", arrowsize=0.7];
"alembic_version" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>alembic_version</B></FONT></TD></TR><TR><TD PORT="version_num" ALIGN="LEFT">version_num</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD PORT="version_num_out">PK</TD></TR></TABLE>>];
"audit_logs" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>audit_logs</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="actor_id" ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="actor_id_out"></TD></TR><TR><TD PORT="object_id" ALIGN="LEFT">object_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="object_id_out"></TD></TR><TR><TD PORT="action" ALIGN="LEFT">action</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="action_out"></TD></TR><TR><TD PORT="before" ALIGN="LEFT">before</TD><TD ALIGN="LEFT">JSON</TD><TD PORT="before_out"></TD></TR><TR><TD PORT="after" ALIGN="LEFT">after</TD><TD ALIGN="LEFT">JSON</TD><TD PORT="after_out"></TD></TR><TR><TD PORT="at" ALIGN="LEFT">at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="at_out"></TD></TR></TABLE>>];
"command_receipts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>command_receipts</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="actor_id" ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="actor_id_out"></TD></TR><TR><TD PORT="key" ALIGN="LEFT">key</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="key_out"></TD></TR><TR><TD PORT="fingerprint" ALIGN="LEFT">fingerprint</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="fingerprint_out"></TD></TR><TR><TD PORT="response" ALIGN="LEFT">response</TD><TD ALIGN="LEFT">JSON</TD><TD PORT="response_out"></TD></TR><TR><TD PORT="at" ALIGN="LEFT">at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="at_out"></TD></TR></TABLE>>];
"idempotency_requests" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>idempotency_requests</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="actor_id" ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="actor_id_out"></TD></TR><TR><TD PORT="key" ALIGN="LEFT">key</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="key_out"></TD></TR><TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="task_id_out"></TD></TR><TR><TD PORT="response_status" ALIGN="LEFT">response_status</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="response_status_out"></TD></TR></TABLE>>];
"stock_movements" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#cbd5e1"><TR><TD COLSPAN="3" BGCOLOR="#1e40af"><FONT COLOR="white"><B>stock_movements</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="id_out">PK</TD></TR><TR><TD PORT="source_task_id" ALIGN="LEFT">source_task_id</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="source_task_id_out"></TD></TR><TR><TD PORT="kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">VARCHAR</TD><TD PORT="kind_out"></TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INTEGER</TD><TD PORT="quantity_out"></TD></TR><TR><TD PORT="at" ALIGN="LEFT">at</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD PORT="at_out"></TD></TR></TABLE>>];
}
